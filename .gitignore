# =====================================================
# 整个仓库共用的忽略规则
# 前端自己的规则在 frontend/.gitignore，后端的在 backend/.gitignore
# =====================================================

# Mac 自动生成的文件夹信息
.DS_Store

# 编辑器的个人设置（IntelliJ / VS Code）
.idea/
.vscode/

# 本地环境变量（可能有密码，绝对不能提交）
.env
.env.*

# Vite 的缓存（在根目录运行过 vite 时会生成）
.vite/
